# Frontend (Vite reads this at build/dev time, prefixed with VITE_)
VITE_API_BASE_URL=http://localhost:8000/api

# Backend
EXECUTION_TIMEOUT_SECONDS=5
EXECUTION_MAX_STEPS=2000

# Authentication & Authorization
APP_SECRET_KEY=dev-live-python-compiler-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# MongoDB user, saved-code, and sharing storage
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=live_python_compiler

# ImageKit profile/media storage
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-imagekit-id

# Optional: OpenAI API Key for AI Help
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=your-free-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
