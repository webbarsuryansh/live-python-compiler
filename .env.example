# Frontend (Vite reads this at build/dev time, prefixed with VITE_)
VITE_API_BASE_URL=http://localhost:8000/api

# Backend
EXECUTION_TIMEOUT_SECONDS=5
EXECUTION_MAX_STEPS=2000

# Authentication & Authorization
APP_SECRET_KEY=dev-live-python-compiler-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional: OpenAI API Key for AI Help
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=your-free-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
